# Copy to backend/.env — never commit real secrets.

PORT=5000
NODE_ENV=development

# Supabase / Postgres. Empty = local SQLite or JSON store.
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

SQLITE_PATH=./data/support.db

# Production CORS allow-list (your Vercel / Render / Railway origin)
FRONTEND_URL=http://localhost:5173

SEED_SAMPLE_DATA=true

# Optional. If set, POST/PUT require header X-Write-Key.
WRITE_KEY=

# Frontend
# VITE_API_URL=/api
# VITE_WRITE_KEY=
