# Copy this file to backend/.env and frontend/.env as needed.
# Never commit real secrets.

# --- Backend (backend/.env) ---
PORT=5000
NODE_ENV=development

# Leave empty to use the bundled SQLite file (good for local / demo).
# For Supabase PostgreSQL, paste the connection string:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Used only when DATABASE_URL is not set
SQLITE_PATH=./data/support.db

# Restrict CORS in production to the Vercel frontend origin
FRONTEND_URL=http://localhost:5173

# Seed demo tickets on first empty database
SEED_SAMPLE_DATA=true

# --- Frontend (frontend/.env) ---
# Leave empty in production if the API is served from the same origin.
VITE_API_URL=http://localhost:5000/api
